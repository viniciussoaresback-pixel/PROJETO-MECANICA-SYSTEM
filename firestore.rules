rules_version = '2';

// Regras de segurança do banco (Firestore) do Mecânica Pro.
// Publique em: Console do Firebase → Firestore Database → Regras → cole este arquivo → Publicar.
// (ou pelo terminal: firebase deploy --only firestore:rules)
//
// Resumo:
// - Cada oficina só enxerga os próprios dados (oficinas/{oficinaId}/...).
// - Só lê e grava quem é "membro" da oficina (o dono ou alguém convidado por ele).
// - Abrir uma oficina NOVA exige liberação (documento liberados/{email} ou sistema/cadastro { aberto: true }).
//   Assim, um estranho que crie uma conta não consegue gravar nada nem gastar a cota do banco.
// - O perfil "mecanico" não vê nem altera as despesas (financeiro) e não apaga registros.
// - Limites de tamanho e de campos em todos os documentos (evita lixo e abuso).
// - Coleções antigas (clientes/servicos com userId) ficam só para leitura, para a migração automática.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    function emailDoUsuario() {
      return request.auth.token.email.lower();
    }
    function caminhoMembro(of) {
      return /databases/$(database)/documents/oficinas/$(of)/membros/$(request.auth.uid);
    }
    function ehMembro(of) {
      return logado() && exists(caminhoMembro(of));
    }
    function papel(of) {
      return get(caminhoMembro(of)).data.papel;
    }
    function ehDono(of) {
      return ehMembro(of) && papel(of) == 'dono';
    }
    function caminhoConvite() {
      return /databases/$(database)/documents/convites/$(emailDoUsuario());
    }
    // Pode abrir oficina nova? (liberação individual por e-mail ou cadastro aberto para todos)
    function cadastroLiberado() {
      return exists(/databases/$(database)/documents/liberados/$(emailDoUsuario()))
        || (exists(/databases/$(database)/documents/sistema/cadastro)
          && get(/databases/$(database)/documents/sistema/cadastro).data.aberto == true);
    }
    function papelValido(p) {
      return p in ['dono', 'atendente', 'mecanico'];
    }

    // A qual oficina a pessoa pertence (só a própria pessoa lê e grava).
    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['oficinaId', 'email']);
    }

    match /oficinas/{of} {
      allow read: if ehMembro(of);
      allow create: if logado() && request.auth.uid == of && cadastroLiberado()
        && request.resource.data.keys().hasOnly(['dono', 'criadoEm']);
      allow update: if logado() && request.auth.uid == of
        && request.resource.data.keys().hasOnly(['dono', 'criadoEm']);

      // Quem pode entrar na oficina
      match /membros/{uid} {
        allow read: if logado() && (uid == request.auth.uid || ehMembro(of));
        // O dono se registra na própria oficina (precisa estar liberado)
        allow create: if logado() && request.auth.uid == of && uid == of && cadastroLiberado()
          && request.resource.data.papel == 'dono'
          && request.resource.data.keys().hasOnly(['nome', 'email', 'papel', 'desde']);
        // Quem foi convidado entra com o perfil que está no convite
        allow create: if logado() && uid == request.auth.uid
          && exists(caminhoConvite())
          && get(caminhoConvite()).data.oficinaId == of
          && request.resource.data.papel == get(caminhoConvite()).data.papel
          && request.resource.data.keys().hasOnly(['nome', 'email', 'papel', 'desde']);
        // Só o dono muda perfis ou remove pessoas (e ninguém mexe no dono principal)
        allow update: if ehDono(of) && uid != of && papelValido(request.resource.data.papel)
          && request.resource.data.keys().hasOnly(['nome', 'email', 'papel', 'desde']);
        allow delete: if ehDono(of) && uid != of;
      }

      // Dados da oficina (nome, logo, textos, tema)
      match /config/{doc} {
        allow read: if ehMembro(of);
        allow write: if ehMembro(of) && papel(of) in ['dono', 'atendente']
          && request.resource.data.keys().size() <= 60
          && (!('logo' in request.resource.data) || request.resource.data.logo.size() <= 400000);
      }

      // Clientes, veículos, OS, estoque, agenda, equipe, financeiro…
      // Mecânico: não vê despesas e não apaga registros (nem marca como excluído).
      match /{colecao}/{id} {
        allow read: if colecao in ['clientes', 'veiculos', 'ordens', 'pecas', 'movimentos', 'servicos', 'equipe', 'agenda', 'despesas']
          && ehMembro(of)
          && (colecao != 'despesas' || papel(of) != 'mecanico');
        allow create, update: if colecao in ['clientes', 'veiculos', 'ordens', 'pecas', 'movimentos', 'servicos', 'equipe', 'agenda', 'despesas']
          && ehMembro(of)
          && (colecao != 'despesas' || papel(of) != 'mecanico')
          && id.size() <= 64
          && request.resource.data.keys().size() <= 80
          && (!('excluido' in request.resource.data) || papel(of) != 'mecanico');
        allow delete: if colecao in ['clientes', 'veiculos', 'ordens', 'pecas', 'movimentos', 'servicos', 'equipe', 'agenda', 'despesas']
          && ehMembro(of) && papel(of) != 'mecanico';
      }
    }

    // Convites: o dono cria; a pessoa convidada lê o próprio convite e o apaga ao aceitar.
    match /convites/{email} {
      allow read: if logado() && (emailDoUsuario() == email || ehDono(resource.data.oficinaId));
      allow create, update: if logado() && email == email.lower() && email.size() <= 200
        && ehDono(request.resource.data.oficinaId)
        && papelValido(request.resource.data.papel)
        && request.resource.data.keys().hasOnly(['oficinaId', 'nome', 'papel', 'oficinaNome', 'criadoEm', 'criadoPor']);
      allow delete: if logado() && (emailDoUsuario() == email || ehDono(resource.data.oficinaId));
    }

    // liberados/{email} e sistema/cadastro: só o responsável mexe, pelo console do Firebase.
    // (Nenhuma regra aqui = ninguém lê nem grava pelo site.)

    // Versão antiga do sistema: só leitura dos próprios dados (para a migração automática).
    match /clientes/{id} {
      allow read: if logado() && resource.data.userId == request.auth.uid;
    }
    match /servicos/{id} {
      allow read: if logado() && resource.data.userId == request.auth.uid;
    }
  }
}

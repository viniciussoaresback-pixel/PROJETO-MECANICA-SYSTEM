{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "files": {
    "includes": ["app/**/*.js", "tests/**/*.js", "tests/**/*.mjs", "!tests/node_modules", "!tests/test-results", "!tests/playwright-report"]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off",
        "useOptionalChain": "warn"
      },
      "style": {
        "noParameterAssign": "off",
        "useTemplate": "off",
        "noUselessElse": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "javascript": {
    "globals": []
  }
}
